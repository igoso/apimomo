{
  "name": "apimomo",
  "version": "1.0.7",
  "description": "",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win",
    "dist:win:installer": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis",
    "dist:win:dir": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --dir",
    "dist:win:portable": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:mac:dir": "vite build && electron-builder --mac dir",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:linux:dir": "vite build && electron-builder --linux dir",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.apimomo.app",
    "productName": "ApiMomo",
    "copyright": "Copyright © 2026 igoso",
    "icon": "build/icon.png",
    "directories": {
      "buildResources": "build",
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApiMomo",
      "artifactName": "ApiMomo-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ApiMomo-${version}-Portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "keywords": [],
  "author": "igoso <igoso@qq.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.28.0",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "dependencies": {
    "curlconverter": "^4.12.0",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "socks-proxy-agent": "^10.1.0"
  }
}
